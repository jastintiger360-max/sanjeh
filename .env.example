# ---- عمومی ----
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# آدرس عمومی سامانه (برای بررسی Origin و کوکی Secure)
PUBLIC_ORIGIN=https://exam.example.ir
DATA_DIR=./data

# ---- پایگاه داده ----
# sqlite (پیش‌فرض، فایل در DATA_DIR) یا postgres
DB_DRIVER=sqlite
# DATABASE_URL=postgres://sanjeh:CHANGE_ME@db:5432/sanjeh

# ---- مدیر اولیه (فقط در اولین اجرا ساخته می‌شود) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD

# ---- هوش مصنوعی (فقط سمت سرور) ----
# openai : هر سرویس سازگار با OpenAI Chat Completions (OpenAI، OpenRouter، vLLM، ...)
# anthropic : Claude Messages API
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# مدل‌های مجاز برای انتخاب در تنظیمات (با کاما)
AI_ALLOWED_MODELS=gpt-4.1,gpt-4.1-mini
AI_DEFAULT_MODEL=gpt-4.1
# مدل جداگانه برای منتقد و حل‌کننده مستقل (اختیاری؛ برای استقلال بیشتر توصیه می‌شود)
AI_REVIEW_MODEL=
AI_JSON_MODE=true
AI_TIMEOUT_MS=120000
# مدل embedding اختیاری برای جست‌وجوی معنایی (خالی = فقط BM25)
AI_EMBEDDING_MODEL=

# ---- OCR ----
OCR_LANGS=fas+eng
